# --- Runtime mode ---
# demo = mocked Power BI tenant + seeded 24-month bank dataset + in-memory store (default, runs with no infra)
# prod = real Entra ID / Power BI REST + PostgreSQL + Redis
SEMABI_MODE=demo

# --- Demo session (demo mode only) ---
SEMABI_DEMO_USER=cro@firstmeridian.demo

# --- Production auth: Microsoft Entra ID (OIDC) ---
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# --- Power BI service principal (prod mode, optional; delegated auth otherwise) ---
PBI_SP_CLIENT_ID=
PBI_SP_CLIENT_SECRET=
PBI_SP_TENANT_ID=

# --- Datastores (prod) ---
DATABASE_URL=postgres://semabi:semabi@localhost:5432/semabi
REDIS_URL=redis://localhost:6379

# --- LLM provider (configurable; Mistral default). No key => template narratives. ---
LLM_PROVIDER=mistral
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_MODEL=mistral-large-latest
MISTRAL_API_KEY=

# --- Notifications ---
RESEND_API_KEY=
RESEND_FROM="SemaBI <digest@semabi.example>"
TEAMS_WEBHOOK_URL=

# --- Scheduling ---
INGEST_SCHEDULE=05:30
DIGEST_SCHEDULE=07:00

# --- Observability ---
SENTRY_DSN=
LOG_LEVEL=info

# --- Data governance ---
AGGREGATE_RETENTION_MONTHS=24
